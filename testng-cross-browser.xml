<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Playwright Cross-Browser and Mobile" parallel="tests" thread-count="4" verbose="1">
    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <test name="Chromium Desktop">
        <parameter name="browser" value="chromium"/>
        <parameter name="viewport" value="desktop"/>
        <classes>
            <class name="com.playwright.tests.LoginTest"/>
            <class name="com.playwright.tests.AddToCartTest"/>
            <class name="com.playwright.tests.CheckoutTest"/>
        </classes>
    </test>

    <test name="Firefox Desktop">
        <parameter name="browser" value="firefox"/>
        <parameter name="viewport" value="desktop"/>
        <classes>
            <class name="com.playwright.tests.LoginTest"/>
            <class name="com.playwright.tests.AddToCartTest"/>
            <class name="com.playwright.tests.CheckoutTest"/>
        </classes>
    </test>

    <test name="WebKit Desktop">
        <parameter name="browser" value="webkit"/>
        <parameter name="viewport" value="desktop"/>
        <classes>
            <class name="com.playwright.tests.LoginTest"/>
            <class name="com.playwright.tests.AddToCartTest"/>
            <class name="com.playwright.tests.CheckoutTest"/>
        </classes>
    </test>

    <test name="Chromium Mobile 390x844">
        <parameter name="browser" value="chromium"/>
        <parameter name="viewport" value="mobile"/>
        <classes>
            <class name="com.playwright.tests.LoginTest"/>
            <class name="com.playwright.tests.AddToCartTest"/>
            <class name="com.playwright.tests.CheckoutTest"/>
            <class name="com.playwright.tests.MobileResponsivenessTest"/>
        </classes>
    </test>
</suite>
