<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Playwright Demo" verbose="1">
    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <test name="Planner">
        <classes>
            <class name="com.playwright.tests.AgentPlanTest"/>
        </classes>
    </test>

    <test name="Login">
        <classes>
            <class name="com.playwright.tests.LoginTest"/>
        </classes>
    </test>

    <test name="Add to Cart">
        <classes>
            <class name="com.playwright.tests.AddToCartTest"/>
        </classes>
    </test>

    <test name="Checkout">
        <classes>
            <class name="com.playwright.tests.CheckoutTest"/>
        </classes>
    </test>
</suite>
